{
  "name": "@atharvaits/react-data-grid",
  "version": "1.0.3",
  "description": "Show any array of records as a table, card grid, or list in React, with sorting, search, filters, paging, virtual scrolling, selection, and export.",
  "keywords": [
    "react",
    "grid",
    "table",
    "data-grid",
    "list",
    "cards",
    "virtualized"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AtharvaITS/npm-packages.git",
    "directory": "packages/react-data-grid"
  },
  "homepage": "https://github.com/AtharvaITS/npm-packages/tree/main/packages/react-data-grid#readme",
  "bugs": {
    "url": "https://github.com/AtharvaITS/npm-packages/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest run --project perf",
    "size": "size-limit",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@size-limit/file": "^14.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.2",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "^14.0.1",
    "tsup": "^8.5.1",
    "vitest": "^5.0.2",
    "vitest-axe": "^0.1.0"
  }
}
